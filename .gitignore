# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
.terraformrc
terraform.rc

# Credentials and local config - nothing in here is ever committed
*.pem
*.key
!**/testdata/*.key
kubeconfig*
!kubeconfig.example
.env
.env.*
secrets.auto.tfvars
*-credentials.json
gcp-sa-*.json
.aws/
.gcp/

# Packer output - a multi-GB qcow2, never committed
packer/**/output/

# Packer - generated locally, contains your public key and local paths
**/variables.auto.pkrvars.hcl
packer/**/output-*/
packer/**/manifest.json

# Ansible
*.retry
ansible/inventory/*.local.yml

# Helm
charts/*.tgz
**/charts/*.tgz

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Downloaded artifacts, verified by digest and re-fetchable. The DIGEST is the thing that lives
# in Git (clusters/onprem/nodes.json); the bytes do not need to.
.cache/
