# kubeadm configuration for the on-prem control plane.
#
#   RENDERED BY ANSIBLE - never copy this file to a node by hand.
#     make onprem-up       renders it and applies the whole cluster
#     make onprem-config   renders it only (ansible --tags config)
#
# This file is the RECORD of how the cluster was built. As of Module 03 it is a Jinja template
# rendered by the control_plane role: every value that could disagree with reality now comes
# from clusters/onprem/nodes.json through the dynamic inventory, so it CANNOT disagree. That is
# strictly better than the Module 02 arrangement, where two files held the same CIDR and a
# script compared them and hoped.
#
# Written against kubeadm.k8s.io/v1beta4, the config API for Kubernetes 1.31+. v1beta3 is
# gone in 1.34, so a tutorial using it predates this cluster. One v1beta4 change that bites:
# kubeletExtraArgs is a list of {name, value} objects, not a map.
#
# Full reasoning for every field: docs/runbooks/cluster-bootstrap.md, step 1.

# ---------------------------------------------------------------------------
# InitConfiguration: true of THIS node, only at the moment of init.
# ---------------------------------------------------------------------------
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  # Must be the node's real address, not 0.0.0.0 - it is baked into the
  # certificates and into every kubeconfig kubeadm generates.
  advertiseAddress: {{ control_plane_address }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  # Explicit, so that a missing runtime fails with "socket not found" rather
  # than "no runtime detected".
  criSocket: unix:///run/containerd/containerd.sock
  taints:
    # kubeadm applies this by default. Written out so that removing it later is a
    # visible edit to a file, not a forgotten kubectl command. With 11 vCPU of
    # worker capacity there is no reason to, and a control plane sharing its 4 GB
    # with workloads is a control plane that dies under load.
    - key: node-role.kubernetes.io/control-plane
      effect: NoSchedule

---
# ---------------------------------------------------------------------------
# ClusterConfiguration: true of the CLUSTER. Stored in etcd and reused by every
# future `kubeadm join` and `kubeadm upgrade`.
# ---------------------------------------------------------------------------
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name }}

# Pinned to what is actually installed (`kubeadm version -o short`). Unset, kubeadm
# chooses for itself; if it chose something newer than the held kubelet packages you
# would run control-plane images from one release against a kubelet from another -
# supported in one direction only, and obscure when it breaks. Pinning also removes a
# network call from init.
kubernetesVersion: {{ kubernetes_version }}

# The most consequential line here, and the one most tutorials omit. This is the name
# clients and joining nodes use to reach the API server. Omit it and everything
# hardcodes 192.168.100.10, so adding a second control plane behind a load balancer
# later means regenerating every certificate and rewriting every kubeconfig. Set to a
# NAME now, that future change is a DNS change.
#
# It resolves because cloud-init wrote /etc/hosts on every node in Module 01.
controlPlaneEndpoint: "{{ control_plane_endpoint }}"

networking:
  # Fixed in ADR-0007, recorded in clusters/onprem/nodes.json. Neither may overlap
  # 192.168.100.0/24, or a pod reaching for a node would route to a pod instead - a
  # failure that looks like DNS and is not.
  podSubnet: {{ pod_cidr }}
  serviceSubnet: {{ service_cidr }}
  dnsDomain: cluster.local

apiServer:
  # Extra names the API server certificate is valid for. Without these, kubectl via any
  # name other than the advertise address fails TLS verification - and you will reach it
  # by several names.
  certSANs:
    - {{ inventory_hostname }}
    - {{ inventory_hostname }}.{{ cluster_domain }}
    - {{ control_plane_address }}
    - 127.0.0.1

etcd:
  local:
    dataDir: /var/lib/etcd

# Do not install kube-proxy at all. ADR-0012: Cilium's eBPF datapath owns Service load
# balancing, and Gateway API requires kubeProxyReplacement.
#
# This only takes effect on a FRESH init - an existing cluster's kube-proxy is removed by the
# kube_proxy_removal role. Without this line, a rebuild would reintroduce kube-proxy and two
# components would program Service rules at once, which does not fail cleanly: some connections
# work, some do not, depending on which path a packet takes first.
proxy:
  disabled: true

---
# ---------------------------------------------------------------------------
# KubeletConfiguration: applies to EVERY node that joins, because kubeadm stores it
# in a ConfigMap in kube-system. This is why a joining worker needs no local config.
# ---------------------------------------------------------------------------
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd

# Ubuntu's /etc/resolv.conf is a symlink to systemd-resolved's STUB file, whose only
# nameserver is 127.0.0.53 - a local listener. The kubelet hands the node's resolv.conf
# to CoreDNS as its upstream, so CoreDNS would forward unresolved queries to a stub on
# its own node, which forwards them back. CoreDNS detects that and refuses to start with
# "Loop ... detected". It presents as cluster-wide DNS failure, which sends you looking
# at CoreDNS rather than at the host. This points the kubelet at the file holding the
# real upstream servers.
resolvConf: /run/systemd/resolve/resolv.conf

# Reserve resources for the OS and the kubelet. Without reservations the kubelet will
# schedule pods until sshd is OOM-killed, and then the node is unreachable and you are
# debugging over the serial console. On a 4 GB control plane this is not a nicety.
systemReserved:
  cpu: "200m"
  memory: "256Mi"
kubeReserved:
  cpu: "200m"
  memory: "256Mi"
evictionHard:
  memory.available: "200Mi"
  nodefs.available: "10%"

# Serial image pulls are the default and they make a three-node rollout crawl.
serializeImagePulls: false

# ---------------------------------------------------------------------------
# There is NO KubeProxyConfiguration here any more.
#
# ADR-0007 kept one so that Module 04 would have a documented "before" state to compare a
# kube-proxy replacement against. ADR-0012 did the replacement, so configuring a component that
# proxy.disabled above prevents from existing would be a lie in a file somebody will later
# believe - and the comparison itself is now recorded by the kube_proxy_removal role, which
# counts the iptables rules before and after.
#
# The historical config, if you want to read what was removed:
#   git show 3fb7dbc:ansible/roles/control_plane/templates/kubeadm-init.yaml.j2
# ---------------------------------------------------------------------------
